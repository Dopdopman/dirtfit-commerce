{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "APP_URL",
    "API_URL",
    "LOG_LEVEL",
    "SWAGGER_ENABLED",
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_ACCESS_TTL",
    "REFRESH_TOKEN_TTL_DAYS",
    "REFRESH_TOKEN_PEPPER",
    "COOKIE_SECRET",
    "COOKIE_SAME_SITE",
    "COOKIE_SECURE",
    "CORS_ALLOWED_ORIGINS",
    "CRON_HMAC_SECRET",
    "RATE_LIMIT_GLOBAL_MAX",
    "RATE_LIMIT_AUTH_MAX",
    "PAYMENT_DEFAULT_PROVIDER",
    "ENABLE_MOCK_PAYMENT",
    "MOCK_PAYMENT_WEBHOOK_SECRET",
    "PAYOS_CLIENT_ID",
    "PAYOS_API_KEY",
    "PAYOS_CHECKSUM_KEY",
    "RESERVATION_TTL_MINUTES",
    "STORAGE_DRIVER",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_BASE_URL",
    "GOOGLE_OAUTH_ENABLED",
    "ENABLE_MOCK_OAUTH",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_CALLBACK_URL",
    "OAUTH_STATE_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_URL", "INTERNAL_API_URL", "NEXT_OUTPUT_STANDALONE"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEXT_PUBLIC_API_URL", "INTERNAL_API_URL", "NEXT_OUTPUT_STANDALONE"]
    },
    "test": {
      "dependsOn": ["^test"],
      "passThroughEnv": ["NEXT_PUBLIC_API_URL", "INTERNAL_API_URL", "NEXT_OUTPUT_STANDALONE"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "passThroughEnv": ["NEXT_PUBLIC_API_URL", "INTERNAL_API_URL", "NEXT_OUTPUT_STANDALONE"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    }
  }
}
