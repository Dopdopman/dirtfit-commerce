{
  "name": "@dirtfit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "verify:compat": "node scripts/verify-stack-compat.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@dirtfit/ergonomics-engine": "workspace:*",
    "@dirtfit/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.9",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.5",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "6.1.0",
    "lru-cache": "11.5.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
