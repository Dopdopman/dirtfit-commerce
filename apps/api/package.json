{
  "name": "@dirtfit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.mjs",
    "test:integration": "vitest run --config vitest.config.mjs",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "verify:compat": "node scripts/verify-stack-compat.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/s3-request-presigner": "3.1176.0",
    "@dirtfit/ergonomics-engine": "workspace:*",
    "@dirtfit/knowledge": "workspace:*",
    "@dirtfit/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.9",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.5",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "6.1.0",
    "jose": "^6.2.18",
    "lru-cache": "11.5.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "^7.3.2"
  }
}
