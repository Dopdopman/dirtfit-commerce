{
  "name": "dirtfit-commerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @dirtfit/api run test:integration",
    "test:system": "playwright test",
    "test:coverage": "turbo run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pure-js": "node scripts/check-pure-js.mjs",
    "verify:compat": "pnpm --filter @dirtfit/api run verify:compat",
    "smoke": "node scripts/smoke-stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-ggr8-5vv4-36mx"
      ]
    },
    "overrides": {
      "postcss": ">=8.5.18",
      "effect": ">=3.22.1 <4.0.0",
      "tinypool": ">=2.1.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "sharp"
    ]
  }
}
